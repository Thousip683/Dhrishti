# Copy to .env and supply your own Gemini API key. Never commit .env.
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-flash-latest
# Optional explicit model override compatible with the imported Dhrishti agent:
# CARBON_GEMINI_MODEL=your-tested-gemini-model-id
DEFAULT_TIMEZONE=Asia/Kolkata
# Durable local API store. Apply migrations with: uv run alembic upgrade head
STORAGE_MODE=database
DATABASE_URL=sqlite:///./carbon_coach.db
# For PostgreSQL: postgresql+psycopg://USER:PASSWORD@HOST/DATABASE
# Optional frontend development adapter, no provider calls:
# GATEWAY_MODE=mock
# Explicit same-origin frontend origins; never use a wildcard with cookies.
ALLOWED_ORIGINS=http://127.0.0.1:8001,http://localhost:8001,http://127.0.0.1:5173,http://localhost:5173
# Enable for every HTTPS deployment; local HTTP development is supported.
# COOKIE_SECURE=true
